let questions = [];
let userAnswers = {};
let timeLeft = 25 * 60;
let timerInterval = null;

function shuffleArray(array) {
    let arr = [...array];
    for (let i = arr.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [arr[i], arr[j]] = [arr[j], arr[i]];
    }
    return arr;
}

function startTimer() {
    clearInterval(timerInterval);
    timeLeft = 25 * 60;
    timerInterval = setInterval(() => {
        timeLeft--;
        let minutes = Math.floor(timeLeft / 60);
        let seconds = timeLeft % 60;
        document.getElementById("timer").innerHTML = `⏱️ ${minutes < 10 ? '0' : ''}${minutes}:${seconds < 10 ? '0' : ''}${seconds}`;
        
        if (timeLeft <= 0) {
            clearInterval(timerInterval);
            alert("⏰ Đã hết thời gian làm bài 25 phút!");
        }
    }, 1000);
}

function initQuiz() {
    questions = shuffleArray(rawQuestions);
    userAnswers = {};
    startTimer();
    updateStats();

    const container = document.getElementById("quiz-container");
    container.innerHTML = "";

    questions.forEach((q, index) => {
        const card = document.createElement("div");
        card.className = "card";
        card.id = `card-${index}`;

        let optionsHtml = "";
        q.options.forEach((opt, optIdx) => {
            optionsHtml += `
                <button class="btn-option" id="btn-${index}-${optIdx}" onclick="selectAnswer(${index}, ${optIdx})">
                    ${opt}
                </button>
            `;
        });

        card.innerHTML = `
            <div class="q-header">
                <span class="q-num">Câu ${index + 1} / 40</span>
                <span class="q-type">${q.type}</span>
            </div>
            <div class="q-text">${q.text}</div>
            <div class="options-grid">
                ${optionsHtml}
            </div>
            <div class="feedback-box" id="fb-${index}"></div>
        `;
        container.appendChild(card);
    });
}

function selectAnswer(qIndex, selectedOptIdx) {
    if (userAnswers[qIndex] !== undefined) return; // Không cho đổi đáp án khi đã chọn

    userAnswers[qIndex] = selectedOptIdx;
    const q = questions[qIndex];
    const isCorrect = selectedOptIdx === q.answer;

    // Vô hiệu hóa các nút chọn câu này
    for (let i = 0; i < q.options.length; i++) {
        const btn = document.getElementById(`btn-${qIndex}-${i}`);
        btn.disabled = true;
        if (i === q.answer) {
            btn.classList.add("correct");
        } else if (i === selectedOptIdx && !isCorrect) {
            btn.classList.add("incorrect");
        }
    }

    // Hiển thị phản hồi tức thì
    const fbBox = document.getElementById(`fb-${qIndex}`);
    if (isCorrect) {
        fbBox.className = "feedback-box show-correct";
        fbBox.innerHTML = `
            <div class="fb-title">✅ Chính xác!</div>
            <div class="fb-explanation"><b>Giải thích:</b> ${q.explanation}</div>
            <div class="fb-example"><b>📌 Ví dụ tương tự:</b> ${q.example}</div>
        `;
    } else {
        fbBox.className = "feedback-box show-incorrect";
        fbBox.innerHTML = `
            <div class="fb-title">❌ Chưa chính xác!</div>
            <div class="fb-explanation"><b>Đáp án đúng:</b> ${q.options[q.answer]}</div>
            <div class="fb-explanation"><b>💡 Giải thích chi tiết:</b> ${q.explanation}</div>
            <div class="fb-example"><b>📌 Ví dụ câu đúng tương tự:</b> ${q.example}</div>
        `;
    }

    updateStats();
}

function updateStats() {
    const answeredCount = Object.keys(userAnswers).length;
    let correctCount = 0;

    Object.keys(userAnswers).forEach(qIndex => {
        if (userAnswers[qIndex] === questions[qIndex].answer) {
            correctCount++;
        }
    });

    document.getElementById("answered-count").innerText = answeredCount;
    document.getElementById("correct-count").innerText = correctCount;
    
    const accuracy = answeredCount > 0 ? Math.round((correctCount / answeredCount) * 100) : 0;
    document.getElementById("accuracy").innerText = `${accuracy}%`;

    const progress = (answeredCount / 40) * 100;
    document.getElementById("progress-bar").style.width = `${progress}%`;
}

// Bắt đầu game khi tải trang
window.onload = initQuiz;
